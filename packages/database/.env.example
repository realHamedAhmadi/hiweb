# Copy to .env in this same folder (packages/database/.env) to run
# `prisma generate` / `prisma migrate dev` locally. Mirrors the
# DATABASE_URL already listed in the repo root .env.example — kept
# here too since Prisma's CLI reads .env from its own package folder,
# not the monorepo root, by default.
DATABASE_URL=postgresql://user:password@localhost:5432/hiweb
