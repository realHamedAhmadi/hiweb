# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Origin(s) allowed to call this API — apps/web's URL.
APP_URL=http://localhost:3000

# --- Database ---
# Consumed indirectly via @hiweb/database (Prisma) — see
# packages/database/.env.example for the canonical version of this.
DATABASE_URL=postgresql://user:password@localhost:5432/hiweb

# --- Auth (JWT + refresh tokens — see authentication-architecture.md Section 2) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- Pi Network ---
# NOT IMPLEMENTED — see src/lib/piNetwork.ts. These are placeholders
# for when real Pi Platform API verification is built.
PI_API_KEY=
PI_APP_ID=
PI_PLATFORM_API_URL=

# --- ⚠️ DEV-ONLY TEST BYPASS — DO NOT SET IN PRODUCTION ⚠️ ---
# When "true" (and NODE_ENV is not "production"), enables
# POST /auth/dev-login — a way to obtain a real session (including
# ADMIN) with NO Pi Network verification at all, for local testing
# only. Leave blank/unset everywhere except your own local machine.
# See src/lib/devAuth.ts for the full warning.
ENABLE_DEV_LOGIN=
