# Client-side (NEXT_PUBLIC_) variables — these are bundled into the
# browser JS, unlike the plain API_URL in the repo root .env.example
# (which is server-only, used by Server Components in lib/api.ts).
# Anything NEXT_PUBLIC_-prefixed here is visible to anyone who opens
# devtools — never put a secret behind this prefix.

# Same backend, but reachable from the browser — may differ from the
# root API_URL if server-side and client-side traffic route
# differently (e.g. an internal vs. public URL). Same value is fine
# for local development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Pi sandbox vs. mainnet (infrastructure-architecture.md Section 1 —
# decided as an environment-level property). "true" for
# development/staging, "false" for production.
NEXT_PUBLIC_PI_SANDBOX=true

# ⚠️ DEV-ONLY TEST BYPASS — DO NOT SET IN PRODUCTION ⚠️
# Shows a visibly-marked "Dev: User" / "Dev: Admin" login shortcut in
# the Header, bypassing Pi Network entirely. Requires the matching
# apps/api ENABLE_DEV_LOGIN=true to actually work (this flag alone
# only controls whether the buttons are rendered — the real guard is
# server-side). Leave blank/unset everywhere except your own local
# machine. See apps/api/src/lib/devAuth.ts for the full warning.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=
